---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const insights = (await getCollection('insights')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<BaseLayout title="资讯动态" description="对外发布的资讯与动态">
  <h1>资讯动态</h1>
  <p class="lead">对外发布的信息与动态。</p>
  <div class="grid">
    {
      insights.map((i) => (
        <a class="card" href="/insights">
          <h3>{i.data.title}</h3>
          <p class="meta">{i.data.date.toLocaleDateString('zh-CN')}</p>
          {i.data.summary && <p>{i.data.summary}</p>}
        </a>
      ))
    }
  </div>
</BaseLayout>
