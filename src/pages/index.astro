---
import BaseLayout from '../layouts/BaseLayout.astro'
import LogoMark from '../components/LogoMark.astro'
---

<BaseLayout bleed>
  <section class="stage">
    <LogoMark size={190} class="stage-mark" />
    <!-- 大字内容在 src/i18n/ui.ts 的 brand.slogan 里改，三语同步 -->
    <h1 data-i18n="brand.slogan">无限不循环的小派</h1>

    <!--
      预留位：后期交互（大图 / 滚动引导 / 动效）加在这里。
      若要换成一张大图，把上面的 LogoMark 换成 <img src="/hero.png" alt="" class="stage-mark" /> 即可。
    -->
  </section>
</BaseLayout>
