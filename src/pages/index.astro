---
import BaseLayout from '../layouts/BaseLayout.astro'
import LogoMark from '../components/LogoMark.astro'
import QuoteStage from '../components/QuoteStage.astro'
import { SITE } from '../data/site'
import { DEFAULT_LANG, t } from '../i18n/ui'

/**
 * 首页大图每日轮换：
 * 池子 = 仅 src/assets/heroes/ 里所有照片（Vite 自动优化、自动发现）。
 * 原 public/hero.png 已永久隐藏，不再参与轮换（pai 要求）。
 * pai 想加图：把照片丢进 src/assets/heroes/ 重新部署即可，不用碰代码。
 * 实际「今天用哪张」由底部 is:inline 脚本按本地日期取模决定（同一天恒定、隔天换，
 * 和「风中的纸屑」同一套确定性逻辑，避免每次刷新都跳一张）。
 */
const heroModules = import.meta.glob('../assets/heroes/*.{jpg,jpeg,png,webp,avif,gif}', {
  eager: true,
  import: 'default',
})
const heroPool: string[] = Object.values(heroModules) as string[]
---

<BaseLayout bleed>
  <section class="hero">
    <!-- 全屏大视觉：默认 public/hero.png（暖调苹果园晨光，中心留白给大字）。
         想固定某张：给 .hero 加 style="--hero-image:url('/xxx.jpg')" 会盖过脚本的每日轮换；
         想每天换：把照片丢进 src/assets/heroes/ 即可。 -->
    <div class="hero-visual" aria-hidden="true"></div>
    <div class="hero-scrim" aria-hidden="true"></div>

    <div class="hero-inner">
      <!-- 小派 logo 是可点的：按一下随机换一条「风中的纸屑」并滑到第二屏 -->
      <button
        class="hero-mark reveal"
        type="button"
        data-i18n-aria="ui.quote.next"
        aria-label={t(DEFAULT_LANG, 'ui.quote.next')}
        style="animation-delay:.1s"
      >
        <LogoMark size={76} />
      </button>
      <h1 class="hero-title reveal" style="animation-delay:.42s">{SITE.statement.cn}</h1>
      <p class="hero-sub reveal" style="animation-delay:.7s">{SITE.statement.en}</p>
    </div>

    <!-- 下滑引导：指向第二屏「风中的纸屑」（打字机）。Brand slogan 保持在 hero 不动。 -->
    <a
      class="hero-cue reveal"
      href="#daily"
      data-i18n="ui.quote.scroll"
      style="animation-delay:1.15s"
    >
      {t(DEFAULT_LANG, 'ui.quote.scroll')}
    </a>

    <!-- 预留位：后期交互（视差 / 鼠标跟随）加在这里。 -->
  </section>

  <QuoteStage />
</BaseLayout>

<!-- 每日轮换大图：按本地日期取模挑一张写进 --hero-image。
     放在文末但仍是 is:inline（解析到 .hero-visual 时它已存在于 DOM），几乎无闪烁。
     想临时固定某张，把上面的 style="--hero-image:..." 加上即可覆盖本脚本。 -->
<script is:inline define:vars={{ heroPool }}>
  (function () {
    if (!heroPool || heroPool.length === 0) return
    var el = document.querySelector('.hero-visual')
    if (!el) return
    var d = new Date()
    var day = Math.floor(
      (Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()) - Date.UTC(1970, 0, 1)) / 86400000
    )
    var url = heroPool[((day % heroPool.length) + heroPool.length) % heroPool.length]
    el.style.setProperty('--hero-image', 'url("' + url + '")')
  })()
</script>
