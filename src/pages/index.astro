---
import BaseLayout from '../layouts/BaseLayout.astro'
import LogoMark from '../components/LogoMark.astro'
import { SITE } from '../data/site'
---

<BaseLayout bleed>
  <section class="hero">
    <!-- 全屏大视觉：默认加载 public/hero.png（暖调苹果园晨光，中心留白给大字）。
         换图：直接替换 public/hero.png；或用别的图时给本 section 加
         style="--hero-image:url('/other.jpg')" -->
    <div class="hero-visual" aria-hidden="true"></div>
    <div class="hero-scrim" aria-hidden="true"></div>

    <div class="hero-inner">
      <span class="hero-mark reveal" style="animation-delay:.1s"><LogoMark size={76} /></span>
      <h1 class="hero-title reveal" style="animation-delay:.42s">{SITE.statement.cn}</h1>
      <p class="hero-sub reveal" style="animation-delay:.7s">{SITE.statement.en}</p>
    </div>

    <!-- 预留位：后期交互（视差 / 滚动引导 / 鼠标跟随）加在这里。 -->
  </section>
</BaseLayout>
