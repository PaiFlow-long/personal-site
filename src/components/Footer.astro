---
import { SITE, NAV } from '../data/site'
import { DEFAULT_LANG, t } from '../i18n/ui'
import LogoMark from './LogoMark.astro'

const year = new Date().getFullYear()
const { cn, en } = SITE.statement
---

<footer class="site">
  <div class="container foot">
    <p class="foot-signature" aria-label={`${cn} · ${en}`}>
      <span class="fs-cn">{cn}</span>
      <span class="fs-en">{en}</span>
    </p>
    <div class="foot-meta">
      <div class="foot-brand">
        <LogoMark size={20} />
        <span>© {year} {SITE.brand}</span>
      </div>
      <nav class="foot-nav" aria-label="Footer">
        {
          NAV.filter((i) => i.path !== '/').map((item) => (
            <a href={item.path} data-i18n={`nav.${item.key}`}>
              {t(DEFAULT_LANG, `nav.${item.key}`)}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</footer>
