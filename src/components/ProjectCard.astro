---
/**
 * 项目卡。
 *
 * 两种形态：
 *  1) 「横条卡」—— 设了 logo 的项目走这条（目前只有 OpenStock）。
 *     左 logo 区 + 右内容区，横向构图，紧凑克制。
 *  2) 「小卡」—— 没 logo 的项目走原来的紧凑竖卡。
 *
 * 加新项目时：想要横条卡就补 logo: /xxx.png，其余字段随意。
 */
const { project } = Astro.props;
const { title, status, summary, url, logo, tech, links, start, end } =
  project.data;

const statusLabel: Record<string, string> = {
  active: '进行中',
  paused: '暂停',
  done: '已完成',
  planned: '计划中',
};

/** 时间区间，形如 2026.09 – 2026.10；进行中则显示「2026.09 – 至今」 */
function fmt(d: Date) {
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, '0');
  return `${y}.${m}`;
}
const range = start ? `${fmt(start)} – ${end ? fmt(end) : '至今'}` : null;

const allLinks =
  links && links.length > 0 ? links : url ? [{ label: '访问站点', href: url }] : [];

const clickable = Boolean(url) && !logo;
---

{
  logo ? (
    <article class="proj-wide">
      <div class="pw-logo">
        <img src={logo} alt={`${title} logo`} width="96" height="96" loading="lazy" />
      </div>

      <div class="pw-body">
        <div class="pw-head">
          <h3>{title}</h3>
          {range && <span class="pw-range">{range}</span>}
        </div>

        {summary && <p class="pw-summary">{summary}</p>}

        <div class="pw-foot">
          {tech && tech.length > 0 && (
            <ul class="pw-tech">
              {tech.map((t: string) => (
                <li>{t}</li>
              ))}
            </ul>
          )}

          {allLinks.length > 0 && (
            <div class="pw-links">
              {allLinks.map((l: { label: string; href: string }) => (
                <a href={l.href} target="_blank" rel="noopener">
                  {l.label}
                  <span aria-hidden="true">↗</span>
                </a>
              ))}
            </div>
          )}
        </div>
      </div>
    </article>
  ) : clickable ? (
    <a class="card project external" href={url} target="_blank" rel="noopener">
      <div class="proj-head">
        <h3>{title}</h3>
        <span class="ext-badge">↗ 子站</span>
      </div>
      <span class={`tag status-${status}`} data-i18n={`ui.status.${status}`}>
        {statusLabel[status]}
      </span>
      {summary && <p>{summary}</p>}
    </a>
  ) : (
    <article class="card project">
      <div class="proj-head">
        <h3>{title}</h3>
        <span class={`tag status-${status}`} data-i18n={`ui.status.${status}`}>
          {statusLabel[status]}
        </span>
      </div>
      {summary && <p>{summary}</p>}
    </article>
  )
}
