---
/**
 * 小派 logo mark（从 IP 手册的人设 SVG 提炼的简化版）
 * 结构：派皮圆 + 奶油窗 + 表情 + 头顶小苹果
 * 纯内联 SVG，无外部资源，任意尺寸都清晰。
 */
interface Props {
  size?: number
  class?: string
  /** 是否带奶油色圆角底板（favicon 用） */
  badge?: boolean
}
const { size = 28, class: className = '', badge = false } = Astro.props
---

<svg
  class={`logo-mark ${className}`}
  width={size}
  height={size}
  viewBox="0 0 100 100"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
>
  {badge && <rect width="100" height="100" rx="22" fill="#FFF7EC" />}
  <!-- 派皮 -->
  <circle cx="50" cy="62" r="28" fill="#E8A85C" stroke="#C8853F" stroke-width="6" />
  <circle cx="50" cy="62" r="24" fill="none" stroke="#F4C97E" stroke-width="2.4" opacity=".55" />
  <!-- 奶油窗 -->
  <circle cx="50" cy="62" r="19" fill="#FFF3DF" stroke="#E0A458" stroke-width="3" />
  <!-- 表情 -->
  <circle cx="42" cy="58" r="3.3" fill="#3A2A1A" />
  <circle cx="58" cy="58" r="3.3" fill="#3A2A1A" />
  <path d="M43 68.5 Q50 75.5 57 68.5" fill="none" stroke="#3A2A1A" stroke-width="3.2" stroke-linecap="round" />
  <!-- 头顶小苹果 -->
  <rect x="47.6" y="1.6" width="4.8" height="9" rx="2.4" fill="#7A4A22" />
  <circle cx="50" cy="20.5" r="13" fill="#E8482B" />
  <path d="M53 10.5 q9 -8.5 15.5 -2.5" fill="none" stroke="#5BA85B" stroke-width="4.4" stroke-linecap="round" />
  <ellipse cx="45" cy="16.5" rx="3.8" ry="5.6" fill="#ffffff" opacity=".35" />
</svg>
