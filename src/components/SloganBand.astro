---
/**
 * 页面底部的宣言签名带
 * 中英双语同时呈现（不随语言切换），作为全站收尾的品牌签名。
 */
import { SITE } from '../data/site'
import LogoMark from './LogoMark.astro'

const { cn, en } = SITE.statement
---

<section class="slogan-band reveal-on-scroll" aria-label={`${cn} · ${en}`}>
  <div class="band-inner">
    <LogoMark size={34} class="band-mark" />
    <p class="band-cn">{cn}</p>
    <p class="band-en">{en}</p>
  </div>
</section>
