---
import { NAV, SITE } from '../data/site'
import { LANGUAGES, DEFAULT_LANG, t } from '../i18n/ui'
import LogoMark from './LogoMark.astro'

const path = Astro.url.pathname
const isActive = (p: string) => (p === '/' ? path === '/' : path.startsWith(p))
---

<header class="site">
  <div class="container bar">
    <a class="brand" href="/" aria-label={SITE.brand}>
      <LogoMark size={26} />
      <span class="brand-name">{SITE.brand}</span>
    </a>

    <button class="icon-btn menu-btn" type="button" data-menu-btn aria-expanded="false" data-i18n-aria="ui.menu" aria-label={t(DEFAULT_LANG, 'ui.menu')}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
    </button>

    <div class="panel" data-panel>
      <nav class="main-nav" aria-label="Primary">
        {
          NAV.map((item) => (
            <a
              href={item.path}
              class={isActive(item.path) ? 'active' : ''}
              aria-current={isActive(item.path) ? 'page' : undefined}
              data-i18n={`nav.${item.key}`}
            >
              {t(DEFAULT_LANG, `nav.${item.key}`)}
            </a>
          ))
        }
      </nav>

      <div class="controls">
        <div class="lang-switch" role="group" aria-label={t(DEFAULT_LANG, 'ui.lang')}>
          {
            LANGUAGES.map((l) => (
              <button
                type="button"
                data-lang={l.code}
                aria-pressed={l.code === DEFAULT_LANG ? 'true' : 'false'}
              >
                {l.label}
              </button>
            ))
          }
        </div>

        <button class="icon-btn theme-btn" type="button" data-theme-btn aria-label={t(DEFAULT_LANG, 'ui.theme.toggle')} data-i18n-aria="ui.theme.toggle">
          <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4.2" />
            <path d="M12 2.5v2.2M12 19.3v2.2M4.2 12H2M22 12h-2.2M5.6 5.6 4 4M20 20l-1.6-1.6M18.4 5.6 20 4M4 20l1.6-1.6" />
          </svg>
          <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 14.2A8.4 8.4 0 0 1 9.8 4 8.4 8.4 0 1 0 20 14.2Z" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>
